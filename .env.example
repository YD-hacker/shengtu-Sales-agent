# 盛途AI电话销售Agent - 环境变量配置
# 复制此文件为 .env 并填入实际值

# 火山引擎（豆包）API Key - 必填
#VOLCENGINE_API_KEY=

# ========== 企业微信自建应用配置 ==========
# 企微管理后台 -> 我的企业 -> 企业ID
#WECHAT_CORPID=

# 企微管理后台 -> 应用管理 -> 自建应用 -> AgentId
#WECHAT_AGENTID=

# 企微管理后台 -> 应用管理 -> 自建应用 -> Secret
#WECHAT_CORPSECRET=

# 企微管理后台 -> 应用管理 -> 接收消息 -> 设置API接收 -> Token
#WECHAT_TOKEN=

# 企微管理后台 -> 应用管理 -> 接收消息 -> 设置API接收 -> EncodingAESKey
#WECHAT_ENCODING_AES_KEY=

# 企微 Webhook（群机器人推送，可选）
#WECHAT_WEBHOOK_URL=

# 项目根目录 - 可选（默认 /opt/ai-agent）
# AGENT_BASE_DIR=/opt/ai-agent
