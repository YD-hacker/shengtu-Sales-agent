[Unit]
Description=盛途AI电话销售Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ai-agent
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/opt/ai-agent/.env
ExecStart=/usr/local/bin/gunicorn -c gunicorn_config.py app:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=10
StandardOutput=append:/opt/ai-agent/logs/stdout.log
StandardError=append:/opt/ai-agent/logs/stderr.log

# 安全加固
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/ai-agent/data /opt/ai-agent/logs

[Install]
WantedBy=multi-user.target
